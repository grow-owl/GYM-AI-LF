# Application Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/gym_ai_saas

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your_super_secret_access_key_here_change_in_prod
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here_change_in_prod
JWT_QR_SECRET=your_super_secret_qr_key_here_change_in_prod
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Cloudinary Integration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Firebase FCM Integration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key\n-----END PRIVATE KEY-----"

# AI Service Keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Rate Limiter Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_PUBLIC_MAX=30

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id

# Security & Auth Settings
SALT_ROUNDS=10
OWNER_INVITE_CODE=change_this_to_a_long_random_secret

# Razorpay Integration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
